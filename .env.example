# Base URL of the Sabbir Book API — BARE server host, NO /api suffix.
# The client appends "/api" itself (see src/config/api.js).
# Dev: http://localhost:5000   Prod (Vercel): https://sabbirbooks-server.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# ─── Sign in with Google ─────────────────────────────────────────────────────
#
# The OAuth "Client ID" from https://console.cloud.google.com/apis/credentials
# → "Create credentials" → "OAuth client ID" → Web application. Add every origin
# the site runs on (http://localhost:3001 in dev, plus production) under
# "Authorised JavaScript origins" — Google's button will not render on an origin
# it does not recognise.
#
# THE AUDIENCE RULE: this exact id must ALSO be set server-side as
# GOOGLE_CLIENT_ID (or GOOGLE_CLIENT_ID_ALT). The browser asks Google for a
# token minted FOR this id, and the server rejects any token whose `aud` is not
# on its own list. A mismatch fails every sign-in with the same vague 401 a
# forged token gets, so it is worth double-checking the strings match.
#
# NEXT_PUBLIC_* is INLINED AT BUILD TIME, not read at runtime: after changing
# this you must rebuild (or restart `next dev`) for it to take effect.
#
# Leave it blank to switch the feature off. The Google button then renders
# nothing at all — no script is fetched, no placeholder, no console output —
# and /login and /register look exactly as they did before it existed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The site's own public origin, e.g. https://magicviva.com
# Required for Facebook/social link previews: Open Graph image and url tags
# must be ABSOLUTE, and Next has no other way to know the deployed domain.
# Without it the tags are still emitted but the image may not resolve.
NEXT_PUBLIC_SITE_URL=

# Set to "on" to bring back the full marketing site (home sections, courses,
# books index, about, contact). Anything else keeps the single book landing
# page. Nothing is deleted either way — see src/config/site.js.
NEXT_PUBLIC_PUBLIC_PAGES=
